---
const {link, alt} = Astro.props
const revealedLink = link.slice(0, -4) + "-revealed.png";
---

<div class="overflow-hidden rounded-2xl scroll-fade lg:hover:-translate-y-2 pointer-events-auto img-container scroll-fade">
    <img src={link} alt={alt} class="block w-full h-auto front-img lg:hover:opacity-0">
</div>

<style define:vars={{ url:  `url(${revealedLink})` }}>
    .img-container {
        background-image: var(--url);
        background-position: top;
        background-repeat: no-repeat;
        background-size: contain;
        transition: translate .3s ease; /* I dont know why it wouldn't work with tailwind */
    }
    img {
        transition: opacity .3s ease; /* ^^^ */
    }
</style>



<script>

    const outputText = document.getElementById("output");

    function copyDiscord() {
        navigator.clipboard.writeText("jayeml");
        outputText!.innerHTML = "Copied username jayeml to clipboard";
    }

    const disc = document.getElementById("discord");
    const git = document.getElementById("github");
    const email = document.getElementById("email");

    disc!.onclick = copyDiscord;
    disc?.addEventListener('mouseenter', () => {outputText!.innerHTML = "Copy my discord username"});
    git?.addEventListener('mouseenter', () => {outputText!.innerHTML = "Open my github"});
    email?.addEventListener('mouseenter', () => {outputText!.innerHTML = "Send me an email"});
    disc?.addEventListener('mouseleave', () => {outputText!.innerHTML = "---"});
    git?.addEventListener('mouseleave', () => {outputText!.innerHTML = "---"});
    email?.addEventListener('mouseleave', () => {outputText!.innerHTML = "---"});



</script>